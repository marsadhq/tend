# Settings for deploy/deploy-tend.sh. Copy this file to deploy/deploy.env
# (which git ignores) and fill it in; anything set in the environment wins
# over the file. One KEY=value per line; # starts a comment line.
#
# Paths on the host are expanded by the host's shell over ssh, so '$HOME'
# (single-quoted here) means the deploy user's home directory there.

# ssh destination: user@host, or a Host alias from ~/.ssh/config. Required.
TEND_DEPLOY_HOST=deploy@tend.example.com

# URL the health check fetches, from the host itself (curl runs there). It
# must answer "ok", like GET /healthz. Required.
TEND_DEPLOY_HEALTH_URL=http://127.0.0.1:8080/healthz

# The SQLite database the service uses (its TEND_DB) on the host, snapshotted
# before every deploy. Required. For a Postgres TEND_DB set it to "skip" and
# take your own pg_dump before a deploy that changes the schema.
TEND_DEPLOY_DB='$HOME/.local/share/tend/tend.db'

# Name of the systemd --user unit (deploy/tend-user.service). Default: tend.
#TEND_DEPLOY_UNIT=tend

# Where the binary lives on the host; the unit's ExecStart must point at
# <this>/tend. Default: '$HOME/bin'.
#TEND_DEPLOY_BIN_DIR='$HOME/bin'

# Where pre-deploy snapshots go on the host. Default: '$HOME/backups'.
#TEND_DEPLOY_BACKUP_DIR='$HOME/backups'

# Audit log on the host, one line per deploy. Default:
# '$HOME/audit/deploys-tend.log'.
#TEND_DEPLOY_AUDIT_LOG='$HOME/audit/deploys-tend.log'

# The go binary used for the build, when it is not on PATH. Default: go.
#GO=go
