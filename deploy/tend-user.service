# Tend — user-level systemd unit (single-operator install, no root). The
# system-wide hardened unit for root installs is deploy/tend.service.
#
# Install (as the user that will run tend; lingering must be enabled once so
# the unit survives logout: `loginctl enable-linger "$USER"`):
#
#   install -D -m 644 tend-user.service ~/.config/systemd/user/tend.service
#   install -d -m 700 ~/.config/tend
#   # ~/.config/tend/env, mode 600: TEND_DB (absolute path), TEND_MASTER_KEY
#   # (required), and optionally TEND_ADDR, TEND_BASE_URL, TEND_RETENTION_*.
#   install -D -m 755 tend ~/bin/tend
#   systemctl --user daemon-reload && systemctl --user enable --now tend
#
# Logs go to the user journal (rotation handled by journald):
#   journalctl --user -u tend
#
# deploy/deploy-tend.sh can then ship new builds to this unit.
#
# A user unit cannot order itself after system services such as a VPN
# daemon. If TEND_ADDR binds an address that appears only once such a
# service is up, `tend serve` fails to bind and exits; Restart=always (with
# no start limit) keeps retrying every RestartSec until the address exists.

[Unit]
Description=Tend job runner & heartbeat monitor
Documentation=https://github.com/marsadhq/tend
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/.config/tend/env
ExecStart=%h/bin/tend serve
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
